{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "firecrawl": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp@3.22.2"],
      "environment": {
        "FIRECRAWL_API_URL": "http://localhost:3002",
        "FIRECRAWL_SELF_HOSTED_DB_ENABLED": "true",
        "FIRECRAWL_MCP_MAX_OUTPUT_CHARS": "400000"
      }
    }
  }
}
