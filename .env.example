# ======================================================================
# Firecrawl Self-Host Configuration
# ======================================================================
# Copy this file to .env and fill in your values.
# All values shown are defaults — change the ones marked with CHANGE_ME.
# ======================================================================

# --- Core ---
PORT=3002
HOST=0.0.0.0
# Published API bind address. Keep loopback unless a reverse proxy/firewall
# protects the API, because self-host mode intentionally bypasses hosted auth.
HOST_BIND_ADDRESS=127.0.0.1
USE_DB_AUTHENTICATION=false
BULL_AUTH_KEY=CHANGE_ME_to_a_random_secret
LOGGING_LEVEL=info

# --- PostgreSQL (internal, not exposed) ---
POSTGRES_USER=firecrawl
POSTGRES_PASSWORD=CHANGE_ME_to_a_random_password
# Must stay "postgres" — the nuq-postgres Dockerfile hardcodes pg_cron
# to the "postgres" database. Any other value breaks the init script.
POSTGRES_DB=postgres
# setup.sh derives this from the PostgreSQL values above during --start.
# Leave it absent for the in-stack database, or set a complete custom URL.

# --- LLM Backend ---
# Any OpenAI-compatible API works. Examples:
#   Fireworks AI:  OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1
#   Ollama:        OPENAI_BASE_URL=http://host.docker.internal:11434/v1
#   OpenAI:        OPENAI_BASE_URL=https://api.openai.com/v1
#
# Fireworks AI model IDs (verify at https://fireworks.ai/models):
#   deepseek-v4-flash-0731: accounts/fireworks/models/deepseek-v4-flash-0731
#
# Unified setup: use the same requested model for extraction, research, and fast paths.
OPENAI_API_KEY=CHANGE_ME_to_your_api_key
# Used by Fireworks-native integrations. Set this to the same key when using
# Fireworks through the OpenAI-compatible endpoint above.
FIREWORKS_API_KEY=
OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1
MODEL_NAME=accounts/fireworks/models/deepseek-v4-flash-0731
MODEL_NAME_FAST=accounts/fireworks/models/deepseek-v4-flash-0731
EXTRACT_ANCHOR_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731
EXTRACT_LIGHT_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731

# --- Ollama (alternative to OpenAI — uncomment to use) ---
# OLLAMA_BASE_URL=http://host.docker.internal:11434/api
# MODEL_NAME=deepseek-r1:7b
# MODEL_EMBEDDING_NAME=nomic-embed-text

# --- Performance Tuning (maxed out for 64-core / 512GB systems) ---
# Adjust down for smaller machines.
NUM_WORKERS_PER_QUEUE=32
NUQ_WORKER_COUNT=32
CRAWL_CONCURRENT_REQUESTS=50
MAX_CONCURRENT_JOBS=50
SELF_HOSTED_CONCURRENCY_LIMIT=50
BROWSER_POOL_SIZE=20
DB_POOL_MAX=8

# --- SearXNG Search Backend ---
# SearXNG is a meta-search engine that aggregates Google, Bing, DuckDuckGo,
# and Wikipedia results. It replaces direct DuckDuckGo calls which get
# IP-banned after a few searches.
SEARXNG_ENDPOINT=http://searxng:8080
SEARXNG_ENGINES=google,bing,duckduckgo,wikipedia
SEARXNG_CATEGORIES=general
SEARXNG_SECRET=CHANGE_ME_to_a_random_string

# --- Research Service ---
# The custom FastAPI research proxy. Runs inside the Docker network.
RESEARCH_PROXY_URL=http://research-service:8000
# Optional: Semantic Scholar API key for higher rate limits
S2_API_KEY=
# Optional: GitHub token for higher rate limits (60 req/hr -> 5000 req/hr)
GITHUB_TOKEN=
# Optional: Email for OpenAlex polite-pool (higher rate limits)
MAILTO=research@firecrawl.local
RESEND_API_KEY=
# Bound local filtering work so a large paper query returns a partial result
# instead of exceeding the API proxy deadline.
PAPER_SEARCH_MAX_PAGES=10
PAPER_SEARCH_SCAN_TIMEOUT_SECONDS=90

# Optional IITM/institutional full-text access. Authenticate interactively in a
# browser and export a Netscape cookie jar outside Git. Never store credentials
# or cookie contents in .env or the repository.
INSTITUTIONAL_ACCESS_ENABLED=false
INSTITUTIONAL_COOKIE_FILE=./config/institutional-cookies.txt
INSTITUTIONAL_ALLOWED_DOMAINS=nature.com,springer.com,sciencedirect.com,elsevier.com,wiley.com,onlinelibrary.wiley.com,academic.oup.com,oup.com,tandfonline.com,nejm.org,science.org,cell.com
INSTITUTIONAL_MAX_DOWNLOAD_BYTES=52428800
INSTITUTIONAL_MAX_PDF_PAGES=100

# --- Browser sessions ---
# The setup patches the existing Playwright renderer with a local session
# adapter, so browser/interact work without a separate Fire Engine account.
BROWSER_SERVICE_URL=http://playwright-service:3000
BROWSER_SERVICE_API_KEY=CHANGE_ME_to_a_random_secret
# Optional internal URL returned for view links; the adapter serves a safe HTML snapshot.
BROWSER_SERVICE_PUBLIC_URL=http://playwright-service:3000

# --- Fire Engine (optional; required for branding and scrape actions) ---
# FIRE_ENGINE_BETA_URL=https://your-compatible-fire-engine.example
# FIRE_ENGINE_STAGING_URL=
# FIRE_ENGINE_AB_URL=
# FIRE_ENGINE_AB_RATE=
# FIRE_ENGINE_AB_MODE=mirror
# AVGRAB_SERVICE_URL=http://your-avgrab-compatible-service:3000

# --- Proxy (optional, for scraping through a proxy) ---
# PROXY_SERVER=
# PROXY_USERNAME=
# PROXY_PASSWORD=
