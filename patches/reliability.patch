diff --git a/apps/api/src/scraper/scrapeURL/transformers/rejectAccessInterstitial.ts b/apps/api/src/scraper/scrapeURL/transformers/rejectAccessInterstitial.ts
new file mode 100644
index 0000000..c54a64a
--- /dev/null
+++ b/apps/api/src/scraper/scrapeURL/transformers/rejectAccessInterstitial.ts
@@ -0,0 +1,36 @@
+import { Document } from "../../../controllers/v2/types";
+import { Meta } from "..";
+import { DocumentAntibotError } from "../error";
+
+const ACCESS_INTERSTITIAL_MARKERS = [
+  /checking your browser before accessing/i,
+  /recaptcha\/(?:api|challengepage)/i,
+  /verify (?:that )?you are (?:a )?human/i,
+  /cf-chl-(?:challenge|widget)/i,
+  /attention required\s*!?\s*cloudflare/i,
+  /enable javascript and cookies to continue/i,
+];
+
+export function isAccessInterstitial(document: Document): boolean {
+  const text = [
+    document.metadata?.title,
+    document.markdown,
+    document.html,
+    document.rawHtml,
+  ]
+    .filter((value): value is string => typeof value === "string")
+    .join("\n")
+    .slice(0, 50_000);
+
+  // Avoid rejecting real articles that merely discuss CAPTCHA systems.
+  if (text.length > 25_000) return false;
+  return ACCESS_INTERSTITIAL_MARKERS.some(pattern => pattern.test(text));
+}
+
+export async function rejectAccessInterstitial(
+  _meta: Meta,
+  document: Document,
+): Promise<Document> {
+  if (isAccessInterstitial(document)) throw new DocumentAntibotError();
+  return document;
+}

diff --git a/apps/api/src/scraper/scrapeURL/transformers/rejectAccessInterstitial.test.ts b/apps/api/src/scraper/scrapeURL/transformers/rejectAccessInterstitial.test.ts
new file mode 100644
index 0000000..0d25ded
--- /dev/null
+++ b/apps/api/src/scraper/scrapeURL/transformers/rejectAccessInterstitial.test.ts
@@ -0,0 +1,23 @@
+import { describe, expect, it } from "vitest";
+import { isAccessInterstitial } from "./rejectAccessInterstitial";
+
+describe("isAccessInterstitial", () => {
+  it("detects the NCBI browser verification page before LLM transforms", () => {
+    expect(
+      isAccessInterstitial({
+        markdown:
+          "Checking your browser before accessing www.ncbi.nlm.nih.gov ... Click here: https://www.google.com/recaptcha/challengepage/#",
+        metadata: { title: "Checking your browser - reCAPTCHA" },
+      } as any),
+    ).toBe(true);
+  });
+
+  it("does not reject a substantive article that discusses CAPTCHA", () => {
+    expect(
+      isAccessInterstitial({
+        markdown: `A long security article about reCAPTCHA. ${"substantive content ".repeat(2000)}`,
+        metadata: { title: "Bot detection research" },
+      } as any),
+    ).toBe(false);
+  });
+});
